# Только плейсхолдеры. Настоящие значения задаются в настройках среды, не в репозитории.
# Пока хотя бы одно значение пустое или среда не разрешена — вход закрыт (fail-closed).
# VNE_AUTH_ENV: development | staging (production этим кодом не принимается)
VNE_AUTH_ENV=
VNE_SUPABASE_URL=https://<project-ref>.supabase.co
VNE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VNE_SITE_URL=https://<site-host>

# Только для интеграционных тестов с локальным Supabase (127.0.0.1)
VNE_INTEGRATION=
VNE_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
VNE_LOCAL_SUPABASE_PUBLISHABLE_KEY=<local-publishable-key>
